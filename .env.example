# IA
ANTHROPIC_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role (Dashboard > Settings > API) — usada SOMENTE pelo webhook
# do Stripe no servidor para atualizar o plano do usuário. Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (pagamentos) — enquanto não configurado, o app funciona sem cobrança
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URL pública do app (fallback para redirects do checkout)
NEXT_PUBLIC_APP_URL=https://satelite-production.up.railway.app
